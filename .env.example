# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Target API Configuration
TARGET_API_BASE_URL=http://localhost:8000
OPENAPI_SPEC_PATH=examples/sample_openapi.json

# Execution Settings
EXECUTION_TIMEOUT=30
ENABLE_DOCKER_SANDBOX=false
DOCKER_IMAGE_NAME=python:3.11-slim

# Storage & Artifact Paths
ARTIFACTS_DIR=artifacts
REPORTS_DIR=artifacts/reports
GENERATED_TESTS_DIR=artifacts/generated_tests
